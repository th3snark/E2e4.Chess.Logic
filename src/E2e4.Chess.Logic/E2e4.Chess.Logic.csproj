<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net45;netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <Product>E2e4 Chess Logic</Product>
    <Description>Chess move generation and rules library: bitboards, legal move generation, FEN parsing, Zobrist hashing and the Position model.</Description>
    <PackageTags>chess;bitboard;move-generation;fen;zobrist;perft</PackageTags>
    <PackageReleaseNotes>See https://github.com/th3snark/E2e4.Chess.Logic/releases for what changed in each version.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/th3snark/E2e4.Chess.Logic</PackageProjectUrl>
    <RepositoryUrl>https://github.com/th3snark/E2e4.Chess.Logic</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- ArgumentNullException.ThrowIfNull does not exist on net45 or netstandard2.0/2.1, so argument checks stay hand-written. -->
    <NoWarn>$(NoWarn);CA1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="E2e4.Chess.Logic.Test" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Model\Position.*.cs">
      <DependentUpon>Position.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- nuget.org drops raw HTML such as the README's <img> icon and shows it as text, and shows images only from allowed hosts (raw.githubusercontent.com is one).
       The packed README is a copy whose icon <img> is a Markdown image on a raw URL pinned to the release tag (GitHub keeps the original). -->
  <Target Name="PackReadme" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <PropertyGroup>
      <RepoRaw>https://raw.githubusercontent.com/th3snark/E2e4.Chess.Logic/v$(Version)/</RepoRaw>
      <PackedReadme>$(MSBuildProjectDirectory)/obj/nuget/README.md</PackedReadme>
      <PackedReadmeText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../README.md'))</PackedReadmeText>
      <PackedReadmeText>$([System.Text.RegularExpressions.Regex]::Replace('$(PackedReadmeText)', '(?m)^&lt;img src="([^"]+)" alt="([^"]*)"[^\r\n]*', '![$2]($(RepoRaw)$1)'))</PackedReadmeText>
    </PropertyGroup>
    <WriteLinesToFile File="$(PackedReadme)" Lines="$([MSBuild]::Escape('$(PackedReadmeText)'))" Overwrite="true" />
    <ItemGroup>
      <None Include="$(PackedReadme)" Pack="true" PackagePath="\" />
    </ItemGroup>
  </Target>

</Project>
